# ---------- Sammlerwert – Konfiguration ----------
# Kopiere diese Datei nach .env und passe die Werte an. Alles Optionale kann leer bleiben.

BRAND_NAME=Sammlerwert
BRAND_TAGLINE=Der Marktwert deiner deutschen Pokémon-Karten.
PUBLIC_URL=https://sammlerwert.de        # öffentliche URL (für Stripe-Redirects)
PORT=4180
NODE_ENV=production
COOKIE_SECURE=true                        # nur hinter HTTPS
ADMIN_EMAILS=camerondillehay99@gmail.com  # Konten mit Admin-Panel (Jobs manuell starten)

# Speicherorte (Docker: /app/data ist ein Volume)
DATA_DIR=./data
DB_PATH=./data/sammlerwert.db
RAW_DIR=./data/raw
UPLOADS_DIR=./data/uploads

# Datenquellen
CARDMARKET_GAME_ID=6                      # 6 = Pokémon
TCGDEX_DETAIL_SETS=sv*,me*,swsh*,sm*,xy*,bw*,base*,neo*,ex*,dp*   # Sets, für die beim Erst-Import volle Kartendetails geladen werden
INGEST_DELAY_MS=80                        # Pause zwischen TCGdex-Anfragen (höflich bleiben)
INGEST_HOUR_UTC=5                         # tägliche Aktualisierung (Cardmarket-Guide erscheint nachts)

# eBay (developer.ebay.com → "Create a keyset", Production). Ohne Keys bleibt der Adapter inaktiv.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_DE
EBAY_ENV=production
EBAY_INSIGHTS_ENABLED=0                   # 1 sobald eBay den Zugang zur Marketplace Insights API (verkaufte Artikel) freigeschaltet hat
EBAY_MAX_CARDS_PER_RUN=400

# Stripe (dashboard.stripe.com → Entwickler → API-Schlüssel / Webhooks). Ohne Keys ist der Checkout deaktiviert.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SAMMLER=                     # price_… des Sammler-Abos (4,99 €/Monat)
STRIPE_PRICE_PRO=                         # price_… des Pro-Abos (9,99 €/Monat)
